# Required
BALE_BOT_TOKEN=PUT_YOUR_BALE_BOT_TOKEN_HERE
BALE_TARGET_CHAT_ID=PUT_YOUR_CHAT_ID_HERE

# Optional
BALE_API_BASE=https://tapi.bale.ai
BACKUP_DIR=/backup
BACKUP_FILE_PATTERNS=*.bak,*.backup,*.dump,*.gz,*.sql,*.sql.gz,*.tar,*.tar.gz,*.xz,*.zip,*.zst
RECURSIVE_SCAN=false
SCAN_INTERVAL_SECONDS=5
STABLE_SECONDS=20
REQUEST_TIMEOUT_SECONDS=120
LONG_POLL_TIMEOUT_SECONDS=30
RETRY_BACKOFF_SECONDS=10
CAPTION_TEMPLATE=Backup uploaded\nFile: {filename}\nSize: {size_human}\nServer: {hostname}\nPublic IP: {public_ip}\nBackup mtime: {file_modified_at}\nSent at: {sent_at}
SERVER_PUBLIC_IP=
PUBLIC_IP_LOOKUP_ENABLED=true
PUBLIC_IP_LOOKUP_URL=https://api.ipify.org
PUBLIC_IP_LOOKUP_TIMEOUT_SECONDS=3
MAX_FILE_SIZE_MB=50
STARTUP_SEND_EXISTING=true
CLEAR_WEBHOOK_ON_START=true
DELETE_UPLOADING_OLDER_THAN_HOURS=24
LOCK_FILE=/tmp/bale-backup-bot.lock
LOG_LEVEL=INFO
